<% content_for :title, "Editing post" %>

<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4">
  <h1 class="text-3xl font-bold text-gray-900">Editing post</h1>
  <div class="flex gap-4">
    <%= link_to "Show", @post, class: "border border-blue-500 text-blue-600 hover:bg-blue-50 font-semibold py-2 px-4 rounded-lg transition duration-200" %>
    <%= link_to "Back to posts", posts_path, class: "border border-gray-300 text-gray-700 hover:bg-gray-50 font-semibold py-2 px-4 rounded-lg transition duration-200" %>
  </div>
</div>

<%= render "form", post: @post %>
