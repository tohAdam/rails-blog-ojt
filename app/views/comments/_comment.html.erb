<div class="post" id="<%= dom_id comment %>">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
    <strong style="color: var(--primary-color); font-size: 1.1rem;"><%= comment.commenter %></strong>
    <% if authenticated? %>
      <div style="display: flex; gap: 0.5rem; align-items: center;">
        <%= link_to "Edit", edit_post_comment_path(comment.post, comment), class: "btn btn-secondary", style: "padding: 0.25rem 0.5rem; font-size: 0.8rem;" %>
        <%= button_to "Delete", [comment.post, comment], method: :delete, class: "btn btn-danger", style: "padding: 0.25rem 0.5rem; font-size: 0.8rem;", form: { style: "margin: 0; padding: 0; background: transparent; border: none; backdrop-filter: none;" } %>
      </div>
    <% end %>
  </div>

  <p>
    <%= comment.body %>
  </p>
</div>
