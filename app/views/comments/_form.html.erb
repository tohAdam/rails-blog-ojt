<% current_post = local_assigns[:post] || @post %>
<%= form_with model: [ current_post, comment ] do |form| %>
  <div class="form-group">
    <%= form.label :commenter, "Name" %><br>
    <%= form.text_field :commenter, placeholder: "Your name" %>
  </div>
  <div class="form-group">
    <%= form.label :body, "Comment" %><br>
    <%= form.text_area :body, placeholder: "Write your comment here..." %>
  </div>
  <div style="display: flex; gap: 1rem;">
    <%= form.submit "Post Comment", class: "btn" %>
    <% if local_assigns[:show_cancel] %>
      <button type="button" class="btn btn-secondary" onclick="document.getElementById('comment-form-container-<%= current_post.id %>').style.display='none'; document.getElementById('show-comment-form-btn-<%= current_post.id %>').style.display='block';">Cancel</button>
    <% end %>
  </div>
<% end %>
