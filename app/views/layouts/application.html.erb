<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Blog">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900 font-sans antialiased">
    <nav style="padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); background: rgba(15, 23, 42, 0.5); backdrop-filter: blur(10px); position: sticky; top: 0; z-index: 50;">
      <div>
        <%= link_to "Home", root_path, style: "font-weight: bold; font-size: 1.25rem; color: var(--text-color); text-decoration: none;" %>
      </div>
      <div style="display: flex; gap: 1rem; align-items: center;">
        <% if authenticated? %>
          <span style="color: var(--text-color); margin-right: 1rem;"><%= Current.user.email_address %></span>
          <%= button_to "Log Out", session_path, method: :delete, class: "btn btn-secondary", style: "padding: 0.5rem 1rem;", form: { style: "margin: 0; padding: 0; background: transparent; border: none; backdrop-filter: none;" } %>
        <% else %>
          <%= link_to "Log In", new_session_path, class: "btn btn-secondary", style: "padding: 0.5rem 1rem;" %>
          <%= link_to "Sign Up", new_registration_path, class: "btn", style: "padding: 0.5rem 1rem;" %>
        <% end %>
      </div>
    </nav>
    <main class="container mx-auto px-4 py-8 max-w-4xl">
      <% if notice.present? %>
        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #34d399; padding: 1rem; border-radius: 0.5rem; text-align: center; margin-bottom: 2rem;"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; padding: 1rem; border-radius: 0.5rem; text-align: center; margin-bottom: 2rem;"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
